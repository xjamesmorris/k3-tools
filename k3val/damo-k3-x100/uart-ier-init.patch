diff --git a/common/uart.c b/common/uart.c
index e5c4feb..339a99f 100644
--- a/common/uart.c
+++ b/common/uart.c
@@ -98,6 +98,12 @@ void uart_putc(char c) {
 #define PLATFORM_UART_IO_WIDTH 1
 #endif
 
+/* IER value written while disabling interrupts. XScale-derived UARTs
+ * (e.g. SpacemiT K3) need bit 6 (UUE, unit enable) to stay set. */
+#ifndef PLATFORM_UART_IER_INIT
+#define PLATFORM_UART_IER_INIT 0x00
+#endif
+
 /* 32-bit I/O width (reg-io-width = <4>): registers must be accessed as
  * 32-bit words. Common on AXI/APB-mapped UARTs. */
 #if PLATFORM_UART_IO_WIDTH >= 4
@@ -138,7 +144,7 @@ void uart_init(void)
      * FIFO reset → status clear. */
 
     /* 1. Disable interrupts */
-    uart_reg_write(UART_IER, 0x00);
+    uart_reg_write(UART_IER, PLATFORM_UART_IER_INIT);
 
     /* 2. Set baud rate: enable DLAB, set divisor */
     uart_reg_write(UART_LCR, UART_LCR_DLAB);
